# SkyPulse 3.0 Environment Configuration

# Application Server Port
PORT=3000

# Optional: Supabase Authentication Credentials
# Create a project at https://supabase.com and copy your project URL and Anon Key below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: OpenWeatherMap API Key
# If provided, enables official OpenWeatherMap 2.5 API telemetry:
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
